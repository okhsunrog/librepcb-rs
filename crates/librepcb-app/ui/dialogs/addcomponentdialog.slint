// The "add component" dialog of the schematic editor.
//
// Not from upstream: port of the Qt dialog
// libs/librepcb/editor/project/addcomponentdialog.{ui,cpp} to Slint, part of
// librepcb-rs. Search field, category tree, component/device/part tree,
// symbol variant chooser and symbol/footprint previews, using upstream's
// widgets (`widgets.slint`).

import {
    Data,
    TreeViewItemData,
} from "../api.slint";
import {
    Button,
    CheckBox,
    ComboBox,
    LineEdit,
    TreeView,
} from "../widgets.slint";

export global AddComponentDialogData {
    in-out property <bool> shown: false;
    in-out property <string> filter;
    // Category tree (shown if the filter is empty). Rows written by the UI
    // (`expanded`) are handled by the backend.
    in-out property <[TreeViewItemData]> categories;
    // Components (level 0), their devices (level 1) and parts (level 2).
    in-out property <[TreeViewItemData]> components;
    in-out property <int> current-component-row: -1;
    in-out property <string> component-name;
    in-out property <string> component-description;
    in-out property <[string]> symbol-variants;
    in-out property <int> symbol-variant-index: -1;
    in-out property <image> symbol-preview;
    in-out property <string> device-name;
    in-out property <image> footprint-preview;
    in-out property <string> error;
    in-out property <bool> can-accept: false;
    in-out property <bool> add-more: true;

    callback filter-edited(string);
    callback category-selected(int);
    callback component-selected(int);
    callback symbol-variant-selected(int);
    callback accepted();
    callback rejected();
}

component PreviewBox inherits Rectangle {
    in property <image> source;
    in property <string> placeholder;

    background: Data.theme.control;
    border-width: 1px;
    border-color: Data.theme.control-border;
    min-height: 120px;

    Image {
        width: parent.width - 4px;
        height: parent.height - 4px;
        source: source;
        image-fit: contain;
    }

    if source.width == 0: Text {
        text: placeholder;
        color: Data.theme.control-text-muted;
        font-size: 12px;
        font-italic: true;
    }
}

export component AddComponentDialog inherits Rectangle {
    in property <length> window-height;

    background: black.with-alpha(0.3 - Data.theme.base.to-hsv().value * 0.2);
    forward-focus: search-edt;

    TouchArea {
        scroll-event(event) => {
            accept
        }
    }

    FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;

        key-pressed(event) => {
            if event.text == Key.Escape {
                AddComponentDialogData.rejected();
                return accept;
            } else if (event.text == Key.Return) && AddComponentDialogData.can-accept {
                AddComponentDialogData.accepted();
                return accept;
            }
            reject
        }

        Rectangle {
            width: min(root.width * 0.95, 1000px);
            height: min(root.height * 0.92, 700px);
            background: Data.theme.base;
            border-radius: 10px;
            border-width: 1px;
            border-color: Data.theme.accent;

            TouchArea { }

            VerticalLayout {
                padding: 15px;
                spacing: 8px;

                Text {
                    text: @tr("Add Component");
                    color: Data.theme.base-text;
                    font-size: 15px;
                    font-weight: 600;
                }

                HorizontalLayout {
                    spacing: 10px;
                    vertical-stretch: 1;

                    VerticalLayout {
                        spacing: 6px;
                        horizontal-stretch: 1;

                        search-edt := LineEdit {
                            vertical-stretch: 0;
                            text: AddComponentDialogData.filter;
                            placeholder-text: @tr("What are you looking for?");
                            accessible-label: "search";

                            init => {
                                self.focus();
                            }

                            text-edited(text) => {
                                AddComponentDialogData.filter = text;
                                AddComponentDialogData.filter-edited(text);
                            }

                            key-pressed(event) => {
                                if (event.text == Key.Return) && AddComponentDialogData.can-accept {
                                    AddComponentDialogData.accepted();
                                    return accept;
                                }
                                reject
                            }
                        }

                        if AddComponentDialogData.filter.is-empty: Rectangle {
                            vertical-stretch: 1;
                            background: Data.theme.control;
                            border-width: 1px;
                            border-color: Data.theme.control-border;

                            TreeView {
                                x: 1px;
                                y: 1px;
                                width: parent.width - 2px;
                                height: parent.height - 2px;
                                font-size: 12px;
                                model: AddComponentDialogData.categories;
                                accessible-label: "categories";

                                item-selected(index, item) => {
                                    AddComponentDialogData.category-selected(index);
                                }

                                item-triggered(index, item) => {
                                    true
                                }
                            }
                        }

                        Rectangle {
                            vertical-stretch: 2;
                            background: Data.theme.control;
                            border-width: 1px;
                            border-color: Data.theme.control-border;

                            TreeView {
                                x: 1px;
                                y: 1px;
                                width: parent.width - 2px;
                                height: parent.height - 2px;
                                font-size: 12px;
                                model: AddComponentDialogData.components;
                                current-index <=> AddComponentDialogData.current-component-row;
                                accessible-label: "components";

                                item-selected(index, item) => {
                                    AddComponentDialogData.current-component-row = index;
                                    AddComponentDialogData.component-selected(index);
                                }

                                item-triggered(index, item) => {
                                    AddComponentDialogData.current-component-row = index;
                                    AddComponentDialogData.component-selected(index);
                                    if AddComponentDialogData.can-accept {
                                        AddComponentDialogData.accepted();
                                    }
                                    true
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 6px;
                        horizontal-stretch: 1;

                        Text {
                            text: AddComponentDialogData.component-name;
                            color: Data.theme.base-text;
                            font-size: 14px;
                            font-weight: 600;
                            overflow: elide;
                        }

                        if !AddComponentDialogData.component-description.is-empty: Text {
                            text: AddComponentDialogData.component-description;
                            color: Data.theme.base-text-muted;
                            font-size: 11px;
                            wrap: word-wrap;
                            max-height: 50px;
                            overflow: elide;
                        }

                        if AddComponentDialogData.symbol-variants.length > 1: ComboBox {
                            model: AddComponentDialogData.symbol-variants;
                            current-index: AddComponentDialogData.symbol-variant-index;
                            window-height: window-height;

                            current-index-changed(index) => {
                                AddComponentDialogData.symbol-variant-index = index;
                                AddComponentDialogData.symbol-variant-selected(index);
                            }
                        }

                        PreviewBox {
                            vertical-stretch: 1;
                            source: AddComponentDialogData.symbol-preview;
                            placeholder: @tr("No component selected");
                        }

                        Text {
                            text: AddComponentDialogData.device-name;
                            color: Data.theme.base-text;
                            font-size: 13px;
                            overflow: elide;
                        }

                        PreviewBox {
                            vertical-stretch: 1;
                            source: AddComponentDialogData.footprint-preview;
                            placeholder: @tr("No device selected");
                        }
                    }
                }

                if !AddComponentDialogData.error.is-empty: Text {
                    text: AddComponentDialogData.error;
                    color: Data.theme.base-text-error;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 6px;

                    CheckBox {
                        text: @tr("Add more");
                        checked: AddComponentDialogData.add-more;
                        status-tip: @tr("If checked, this dialog will automatically be opened again after finishing placement of the current component.");

                        toggled(checked) => {
                            AddComponentDialogData.add-more = checked;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    Button {
                        width: max(self.preferred-width, 90px);
                        text: @tr("Cancel");

                        clicked => {
                            AddComponentDialogData.rejected();
                        }
                    }

                    Button {
                        width: max(self.preferred-width, 90px);
                        text: @tr("OK");
                        icon: @image-url("../resources/libs/font-awesome/svgs/solid/check.svg");
                        primary: true;
                        enabled: AddComponentDialogData.can-accept;

                        clicked => {
                            AddComponentDialogData.accepted();
                        }
                    }
                }
            }
        }
    }
}
