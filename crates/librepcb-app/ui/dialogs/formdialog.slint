// Generic form dialogs: the properties dialogs of the schematic and board
// editors, board setup, project setup, output jobs, graphics export, BOM
// review and pick&place generator.
//
// Not from upstream: upstream uses Qt Widgets dialogs (`*.ui`) for these.
// This file is part of librepcb-rs. The backend (`src/dialogs/`) describes
// each dialog as a list of fields (`FormField`) with the labels of the
// upstream dialogs (translated with the upstream Qt contexts); this file
// renders them with upstream's widgets (`widgets.slint`) and reports edits
// by writing the field rows (like upstream's models written by the UI).

import { ScrollView } from "std-widgets.slint";
import {
    AngleEditData,
    AttributeData,
    Data,
    Int64,
    LengthEditData,
    LengthUnit,
    RatioEditData,
} from "../api.slint";
import {
    AngleEdit,
    AttributeListView,
    Button,
    CheckBox,
    ComboBox,
    HAlignSelector,
    IconButton,
    LengthEdit,
    LineEdit,
    RatioEdit,
    TextEdit,
    VAlignSelector,
} from "../widgets.slint";

export enum FormFieldKind {
    header,  // Section title (text: label)
    note,  // Wrapped informational text (text)
    label,  // Read-only value (text)
    text,  // Single line text (text, placeholder, suggestions)
    multiline,  // Multi-line text (text, rows)
    length,  // Length (length, auto-supported, auto-checked)
    angle,  // Angle (angle)
    ratio,  // Ratio (ratio)
    checkbox,  // Check box (checked, text)
    choice,  // Combo box (options, index)
    radio,  // Radio buttons, one per row (options, index)
    halign,  // Horizontal alignment (index 0..2)
    valign,  // Vertical alignment (index 0..2)
    list,  // List or table (items, columns, index, rows, list-* flags)
    attributes,  // Attribute list editor (attributes)
    button,  // Push button (text)
}

// Set by the UI, reset by the backend.
export enum FormFieldAction {
    none,
    increase,  // Length/ratio step up
    decrease,  // Length/ratio step down
    clicked,  // Button clicked
    select,  // List row `action-row` selected
    toggle,  // List row `action-row` check state toggled
    add,  // List: add `action-text`
    remove,  // List: remove row `action-row`
    move-up,  // List: move row `action-row` up
    move-down,  // List: move row `action-row` down
    duplicate,  // List: duplicate row `action-row`
    activate,  // List: row `action-row` double-clicked
}

export struct FormListItem {
    text: string,
    cells: [string],  // Table cells (if the list has columns)
    checkable: bool,
    checked: bool,
    color: color,  // Color swatch (if not transparent)
    enabled: bool,  // Grayed out if false
}

export struct FormField {
    id: string,  // Backend identifier of the field
    kind: FormFieldKind,
    label: string,  // Text of the label column (empty: no label; lists and attributes span both columns)
    text: string,
    placeholder: string,
    suggestions: [string],
    length: LengthEditData,
    auto-supported: bool,
    auto-checked: bool,
    angle: AngleEditData,
    ratio: RatioEditData,
    checked: bool,
    options: [string],
    index: int,
    items: [FormListItem],
    columns: [string],
    rows: int,  // Visible rows of lists and multi-line texts
    list-add: bool,  // List with an input to add items (text, suggestions)
    list-remove: bool,
    list-move: bool,
    list-duplicate: bool,
    attributes: [AttributeData],
    enabled: bool,
    error: string,
    hint: string,  // Small text below the field
    page: int,  // Index of the page (tab) the field is shown on
    column: int,  // 0: main column, 1: side column (left)
    action: FormFieldAction,
    action-row: int,
    action-text: string,
}

export global Dialogs {
    // Form dialog.
    in-out property <bool> form-shown: false;
    in-out property <string> form-title;
    in-out property <[string]> form-pages;
    in-out property <int> form-page: 0;
    in-out property <[FormField]> form-fields;
    in-out property <string> form-error;
    in-out property <string> form-ok-text;
    in-out property <bool> form-has-apply: false;
    in-out property <bool> form-has-cancel: true;
    in-out property <[string]> form-extra-buttons;
    in-out property <length> form-label-width: 150px;
    in-out property <length> form-width: 550px;
    in-out property <length> form-side-width: 250px;
    in-out property <bool> form-has-side: false;
    in-out property <image> form-preview;
    in-out property <bool> form-preview-shown: false;
    in-out property <string> form-preview-caption;
    in-out property <bool> form-busy: false;
    // -2: cancel, -1: OK, 0: apply, 1+: extra button (index + 1)
    callback form-button(int);
}

component FieldLabel inherits Text {
    color: Data.theme.base-text;
    font-size: 12px;
    vertical-alignment: center;
    horizontal-alignment: left;
    overflow: elide;
    accessible-role: none;
}

component ListRow inherits Rectangle {
    in property <FormListItem> item;
    in property <[string]> columns;
    in property <bool> selected;
    in property <bool> enabled;

    callback clicked;
    callback double-clicked;
    callback toggled;

    height: 22px;
    background: {
        if selected {
            Data.theme.control-checked
        } else if ta.has-hover {
            Data.theme.control-hovered
        } else {
            transparent
        }
    };

    ta := TouchArea {
        enabled: enabled;

        clicked => {
            root.clicked();
        }

        double-clicked => {
            root.double-clicked();
        }
    }

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 6px;

        if item.checkable: CheckBox {
            checked: item.checked;
            enabled: enabled;
            focusable: false;

            toggled(checked) => {
                root.toggled();
            }
        }

        if item.color.alpha > 0: Rectangle {
            y: (parent.height - self.height) / 2;
            width: 14px;
            height: 14px;
            background: item.color;
            border-width: 1px;
            border-color: Data.theme.control-border;
        }

        if columns.length == 0: Text {
            text: item.text;
            color: item.enabled ? Data.theme.control-text : Data.theme.control-text-disabled;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }

        for cell[c] in item.cells: Text {
            min-width: 0;
            horizontal-stretch: 1;
            text: cell;
            color: item.enabled ? Data.theme.control-text : Data.theme.control-text-disabled;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component FormList inherits VerticalLayout {
    in property <FormField> field;
    property <length> row-height: 22px;
    property <string> add-text;

    callback action(FormFieldAction, int, string);

    spacing: 4px;

    Rectangle {
        height: max(3, field.rows) * row-height + (field.columns.length > 0 ? row-height : 0) + 2px;
        background: Data.theme.control;
        border-width: 1px;
        border-color: Data.theme.control-border;

        VerticalLayout {
            padding: 1px;

            if field.columns.length > 0: Rectangle {
                height: row-height;
                background: Data.theme.control-hovered;

                HorizontalLayout {
                    padding-left: 4px;
                    padding-right: 4px;
                    spacing: 6px;

                    for col in field.columns: Text {
                        min-width: 0;
                        horizontal-stretch: 1;
                        text: col;
                        color: Data.theme.control-text;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }

            ScrollView {
                VerticalLayout {
                    alignment: start;

                    for item[i] in field.items: ListRow {
                        item: item;
                        columns: field.columns;
                        selected: i == field.index;
                        enabled: field.enabled;

                        clicked => {
                            action(FormFieldAction.select, i, "");
                        }

                        double-clicked => {
                            action(FormFieldAction.activate, i, "");
                        }

                        toggled => {
                            action(FormFieldAction.toggle, i, "");
                        }
                    }
                }
            }
        }
    }

    if field.list-add || field.list-remove || field.list-move || field.list-duplicate: HorizontalLayout {
        spacing: 4px;

        if field.list-add: LineEdit {
            text: add-text;
            placeholder-text: field.placeholder;
            suggestions: field.suggestions;
            enabled: field.enabled;
            show-clear-button: false;

            text-edited(text) => {
                add-text = text;
            }

            key-pressed(event) => {
                if event.text == Key.Return {
                    action(FormFieldAction.add, -1, add-text);
                    add-text = "";
                    return accept;
                }
                reject
            }

            suggestion-accepted(text) => {
                add-text = text;
            }
        }

        if field.list-add: Button {
            text: @tr("EditorCommandSet" => "Add");
            enabled: field.enabled;

            clicked => {
                action(FormFieldAction.add, -1, add-text);
                add-text = "";
            }
        }

        if !field.list-add: Rectangle {
            horizontal-stretch: 1;
        }

        if field.list-move: Button {
            text: "▲";
            enabled: field.enabled && (field.index > 0);
            accessible-label: "move up";

            clicked => {
                action(FormFieldAction.move-up, field.index, "");
            }
        }

        if field.list-move: Button {
            text: "▼";
            enabled: field.enabled && (field.index >= 0) && (field.index < (field.items.length - 1));
            accessible-label: "move down";

            clicked => {
                action(FormFieldAction.move-down, field.index, "");
            }
        }

        if field.list-duplicate: Button {
            text: @tr("EditorCommandSet" => "Duplicate");
            enabled: field.enabled && (field.index >= 0);

            clicked => {
                action(FormFieldAction.duplicate, field.index, "");
            }
        }

        if field.list-remove: Button {
            text: @tr("EditorCommandSet" => "Remove");
            enabled: field.enabled && (field.index >= 0);

            clicked => {
                action(FormFieldAction.remove, field.index, "");
            }
        }
    }
}

// One row of a form: label column and editor.
export component FormRow inherits VerticalLayout {
    in property <FormField> field;
    in property <length> label-width;
    in property <length> window-height;

    // Edits, applied to the model row by the parent (`FormView`).
    callback text-edited(string);
    callback checked-edited(bool);
    callback index-edited(int);
    callback length-edited(Int64);
    callback unit-edited(LengthUnit);
    callback auto-edited(bool);
    callback number-edited(int);  // Angle or ratio
    callback set-action(FormFieldAction, int, string);

    spacing: 2px;

    if field.kind == FormFieldKind.header: VerticalLayout {
        padding-top: 6px;
        spacing: 3px;

        Text {
            text: field.label;
            color: Data.theme.base-text;
            font-size: 13px;
            font-weight: 700;
        }

        Rectangle {
            height: 1px;
            background: Data.theme.base-border;
        }
    }

    if field.kind == FormFieldKind.note: Text {
        text: field.text;
        color: Data.theme.base-text-muted;
        font-size: 11px;
        wrap: word-wrap;
    }

    if (field.kind != FormFieldKind.header) && (field.kind != FormFieldKind.note): HorizontalLayout {
        spacing: 8px;

        if !field.label.is-empty: FieldLabel {
            width: label-width;
            height: 25px;
            y: 0;
            text: field.label;
        }

        // Editors without label stay aligned with the labeled ones.
        if field.label.is-empty && (field.kind != FormFieldKind.list) && (field.kind != FormFieldKind.attributes) && (label-width > 0): Rectangle {
            width: label-width;
        }

        VerticalLayout {
            spacing: 2px;
            horizontal-stretch: 1;

            if field.kind == FormFieldKind.label: Text {
                min-height: 25px;
                text: field.text;
                color: field.enabled ? Data.theme.base-text : Data.theme.base-text-disabled;
                font-size: 12px;
                vertical-alignment: center;
                wrap: word-wrap;
            }

            if field.kind == FormFieldKind.text: LineEdit {
                min-height: 25px;
                text: field.text;
                placeholder-text: field.placeholder;
                suggestions: field.suggestions;
                validation-error: field.error;
                enabled: field.enabled;
                accessible-label: field.id;

                text-edited(text) => {
                    text-edited(text);
                }

                suggestion-accepted(text) => {
                    text-edited(text);
                }
            }

            if field.kind == FormFieldKind.multiline: TextEdit {
                height: max(2, field.rows) * 18px + 8px;
                text: field.text;
                placeholder-text: field.placeholder;
                validation-error: field.error;
                enabled: field.enabled;
                accessible-label: field.id;

                text-edited(text) => {
                    text-edited(text);
                }
            }

            if field.kind == FormFieldKind.length: HorizontalLayout {
                alignment: start;

                LengthEdit {
                    width: 160px;
                    height: 25px;
                    data: field.length;
                    enabled: field.enabled;
                    auto-supported: field.auto-supported;
                    auto-checked: field.auto-checked;
                    accessible-label: field.id;

                    value-changed(v) => {
                        length-edited(v);
                    }

                    unit-changed(u) => {
                        unit-edited(u);
                    }

                    auto-toggled(checked) => {
                        auto-edited(checked);
                    }

                    increase-triggered => {
                        set-action(FormFieldAction.increase, -1, "");
                    }

                    decrease-triggered => {
                        set-action(FormFieldAction.decrease, -1, "");
                    }
                }
            }

            if field.kind == FormFieldKind.angle: HorizontalLayout {
                alignment: start;

                AngleEdit {
                    width: 160px;
                    height: 25px;
                    data: field.angle;
                    enabled: field.enabled;
                    accessible-label: field.id;

                    value-changed(v) => {
                        number-edited(v);
                    }

                    increase-triggered => {
                        set-action(FormFieldAction.increase, -1, "");
                    }

                    decrease-triggered => {
                        set-action(FormFieldAction.decrease, -1, "");
                    }
                }
            }

            if field.kind == FormFieldKind.ratio: HorizontalLayout {
                alignment: start;

                RatioEdit {
                    width: 160px;
                    height: 25px;
                    data: field.ratio;
                    enabled: field.enabled;
                    accessible-label: field.id;

                    value-changed(v) => {
                        number-edited(v);
                    }

                    increase-triggered => {
                        set-action(FormFieldAction.increase, -1, "");
                    }

                    decrease-triggered => {
                        set-action(FormFieldAction.decrease, -1, "");
                    }
                }
            }

            if field.kind == FormFieldKind.checkbox: CheckBox {
                min-height: 25px;
                text: field.text;
                checked: field.checked;
                enabled: field.enabled;

                toggled(checked) => {
                    checked-edited(checked);
                }
            }

            if field.kind == FormFieldKind.choice: ComboBox {
                model: field.options;
                current-index: field.index;
                enabled: field.enabled;
                window-height: window-height;
                accessible-label: field.id;

                current-index-changed(index) => {
                    index-edited(index);
                }
            }

            if field.kind == FormFieldKind.radio: VerticalLayout {
                for option[i] in field.options: CheckBox {
                    min-height: 22px;
                    text: option;
                    checked: i == field.index;
                    enabled: field.enabled;

                    toggled(checked) => {
                        index-edited(i);
                    }
                }
            }

            if field.kind == FormFieldKind.halign: HorizontalLayout {
                alignment: start;

                HAlignSelector {
                    height: 25px;
                    index: field.index;
                    enabled: field.enabled;

                    index-clicked(i) => {
                        index-edited(i);
                    }
                }
            }

            if field.kind == FormFieldKind.valign: HorizontalLayout {
                alignment: start;

                VAlignSelector {
                    height: 25px;
                    index: field.index;
                    enabled: field.enabled;

                    index-clicked(i) => {
                        index-edited(i);
                    }
                }
            }

            if field.kind == FormFieldKind.list: FormList {
                field: field;

                action(action, row, text) => {
                    set-action(action, row, text);
                }
            }

            if field.kind == FormFieldKind.attributes: AttributeListView {
                model: field.attributes;
                read-only: !field.enabled;
                window-height: window-height;
            }

            if field.kind == FormFieldKind.button: HorizontalLayout {
                alignment: start;

                Button {
                    text: field.text;
                    enabled: field.enabled;

                    clicked => {
                        set-action(FormFieldAction.clicked, -1, "");
                    }
                }
            }

            if (field.kind != FormFieldKind.text) && (field.kind != FormFieldKind.multiline) && (!field.error.is-empty): Text {
                text: field.error;
                color: Data.theme.base-text-error;
                font-size: 11px;
                wrap: word-wrap;
            }

            if !field.hint.is-empty: Text {
                text: field.hint;
                color: Data.theme.base-text-muted;
                font-size: 11px;
                wrap: word-wrap;
            }
        }
    }
}

// The fields of one page and column of a form.
export component FormView inherits ScrollView {
    in property <int> page;
    in property <int> column;
    in property <length> label-width;
    in property <length> window-height;

    mouse-drag-pan-enabled: false;

    l := VerticalLayout {
        alignment: start;
        padding-right: 10px;
        spacing: 0px;

        for field[i] in Dialogs.form-fields: FormRow {
            // Fields of other pages/columns take no space (not even the
            // spacing between rows).
            visible: (field.page == page) && (field.column == column);
            padding-bottom: self.visible ? 6px : 0px;
            height: self.visible ? self.preferred-height : 0;
            field: field;
            label-width: label-width;
            window-height: window-height;

            text-edited(text) => {
                field.text = text;
            }

            checked-edited(checked) => {
                field.checked = checked;
            }

            index-edited(index) => {
                field.index = index;
            }

            length-edited(value) => {
                field.length.value = value;
            }

            unit-edited(unit) => {
                field.length.unit = unit;
            }

            auto-edited(checked) => {
                field.auto-checked = checked;
            }

            number-edited(value) => {
                if field.kind == FormFieldKind.angle {
                    field.angle.value = value;
                } else {
                    field.ratio.value = value;
                }
            }

            set-action(action, row, text) => {
                field.action-row = row;
                field.action-text = text;
                field.action = action;
            }
        }
    }
}

component PageButton inherits Rectangle {
    in property <string> text;
    in property <bool> checked;

    callback clicked;

    height: 28px;
    width: txt.preferred-width + 24px;
    background: checked ? Data.theme.base : (ta.has-hover ? Data.theme.control-hovered : transparent);
    border-radius: 4px;

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    txt := Text {
        text: root.text;
        color: checked ? Data.theme.base-text : Data.theme.base-text-muted;
        font-size: 12px;
        font-weight: checked ? 600 : 400;
    }

    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: checked ? Data.theme.accent : transparent;
    }
}

// The dialog, shown as an overlay over the main window.
export component FormDialog inherits Rectangle {
    in property <length> window-height;

    background: black.with-alpha(0.3 - Data.theme.base.to-hsv().value * 0.2);
    forward-focus: fs;

    init => {
        fs.focus();
    }

    TouchArea {
        // Discard clicks and scroll events outside the dialog.
        scroll-event(event) => {
            accept
        }
    }

    fs := FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;

        key-pressed(event) => {
            if event.text == Key.Escape {
                Dialogs.form-button(-2);
                return accept;
            }
            reject
        }

        frame := Rectangle {
            property <bool> has-side: Dialogs.form-has-side;

            width: min(root.width * 0.95, Dialogs.form-width + (has-side ? Dialogs.form-side-width + 10px : 0) + (Dialogs.form-preview-shown ? 420px : 0));
            height: min(root.height * 0.92, max(l.preferred-height, 200px));
            background: Data.theme.base;
            border-radius: 10px;
            border-width: 1px;
            border-color: Data.theme.accent;

            TouchArea {
                // Discard clicks within the dialog content.
            }

            l := VerticalLayout {
                padding: 15px;
                spacing: 8px;

                Text {
                    text: Dialogs.form-title;
                    color: Data.theme.base-text;
                    font-size: 15px;
                    font-weight: 600;
                    overflow: elide;
                }

                if Dialogs.form-pages.length > 1: HorizontalLayout {
                    alignment: start;
                    spacing: 2px;

                    for page[p] in Dialogs.form-pages: PageButton {
                        text: page;
                        checked: p == Dialogs.form-page;

                        clicked => {
                            Dialogs.form-page = p;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    vertical-stretch: 1;

                    if frame.has-side: FormView {
                        width: Dialogs.form-side-width;
                        page: 0;
                        column: 1;
                        label-width: 0px;
                        window-height: window-height;
                    }

                    FormView {
                        preferred-height: 400px;
                        page: Dialogs.form-page;
                        column: 0;
                        label-width: Dialogs.form-label-width;
                        window-height: window-height;
                    }

                    if Dialogs.form-preview-shown: VerticalLayout {
                        width: 410px;
                        spacing: 4px;

                        Rectangle {
                            background: Data.theme.control;
                            border-width: 1px;
                            border-color: Data.theme.control-border;

                            Image {
                                width: parent.width - 4px;
                                height: parent.height - 4px;
                                source: Dialogs.form-preview;
                                image-fit: contain;
                            }
                        }

                        Text {
                            text: Dialogs.form-preview-caption;
                            color: Data.theme.base-text-muted;
                            font-size: 11px;
                            horizontal-alignment: center;
                        }
                    }
                }

                if !Dialogs.form-error.is-empty: Text {
                    text: Dialogs.form-error;
                    color: Data.theme.base-text-error;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 6px;

                    for text[b] in Dialogs.form-extra-buttons: Button {
                        text: text;
                        enabled: !Dialogs.form-busy;

                        clicked => {
                            Dialogs.form-button(b + 1);
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    if Dialogs.form-has-cancel: Button {
                        width: max(self.preferred-width, 90px);
                        text: @tr("MessagePopup" => "Cancel");

                        clicked => {
                            Dialogs.form-button(-2);
                        }
                    }

                    if Dialogs.form-has-apply: Button {
                        width: max(self.preferred-width, 90px);
                        text: @tr("RuleCheckPanel" => "Apply");
                        enabled: !Dialogs.form-busy;

                        clicked => {
                            Dialogs.form-button(0);
                        }
                    }

                    Button {
                        width: max(self.preferred-width, 90px);
                        text: Dialogs.form-ok-text.is-empty ? @tr("MessagePopup" => "OK") : Dialogs.form-ok-text;
                        icon: @image-url("../resources/libs/font-awesome/svgs/solid/check.svg");
                        primary: true;
                        enabled: !Dialogs.form-busy;

                        clicked => {
                            Dialogs.form-button(-1);
                        }
                    }
                }
            }
        }
    }
}
