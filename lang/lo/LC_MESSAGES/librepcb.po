msgctxt "librepcb::editor::EagleLibraryImportWizardPage_SetOptions"
msgid "Set Options"
msgstr "ຕັ້ງຄ່າຕົວເລືອກ"

#: libs/librepcb/editor/library/eaglelibraryimportwizard/eaglelibraryimportwizardpage_setoptions.ui:20
msgctxt "librepcb::editor::EagleLibraryImportWizardPage_SetOptions"
msgid "Choose the import options and click on the import button below to continue. If you are unsure about the options, just keep the default values."
msgstr "ເລືອກຕົວເລືອກການນຳເຂົ້າ ແລ້ວກົດປຸ່ມນຳເຂົ້າລຸ່ມນີ້ເພື່ອດຳເນີນການຕໍ່. ຖ້າເຈົ້າບໍ່ໝັ້ນໃຈ, ໃຫ້ໃຊ້ຄ່າເລີ່ມຕົ້ນ."

#: libs/librepcb/editor/library/eaglelibraryimportwizard/eaglelibraryimportwizardpage_setoptions.ui:29
msgctxt "librepcb::editor::EagleLibraryImportWizardPage_SetOptions"
