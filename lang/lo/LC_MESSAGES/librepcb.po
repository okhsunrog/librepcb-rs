#: libs/librepcb/core/network/orderpcbapirequest.cpp:85
msgctxt "librepcb::OrderPcbApiRequest"
msgid "The project is too large ({0}). If you manually added files to the project directory, you might need to move them out of the project directory."
msgstr "ໂຄງການມີຂະໜາດໃຫຍ່ເກີນໄປ ({0}). ຫາກທ່ານເພີ່ມໄຟລ໌ລົງໃນໂຟນເດີໂຄງການດ້ວຍຕົນເອງ, ທ່ານອາດຈະຕ້ອງຍ້າຍພວກມັນອອກຈາກໂຟນເດີດັ່ງກ່າວ."

#: libs/librepcb/core/network/orderpcbapirequest.cpp:138
msgctxt "librepcb::OrderPcbApiRequest"
msgid "This service is currently not available. Please try again later or order the PCB manually either with the Gerber export or the *.lppz export."
msgstr "ການບໍລິການນີ້ຍັງບໍ່ພ້ອມໃຊ້ງານໃນຕອນນີ້. ກະລຸນາລອງໃໝ່ພາຍຫຼັງ ຫຼື ສັ່ງຜະລິດ PCB ດ້ວຍຕົນເອງໂດຍການສົ່ງອອກ Gerber ຫຼື *.lppz."

#: libs/librepcb/core/fileio/outputdirectorywriter.cpp:116
msgctxt "librepcb::OutputDirectoryWriter"
msgid "The output file path '{0}' is invalid."
msgstr "ເສັ້ນທາງໄຟລ໌ສົ່ງອອກ '{0}' ບໍ່ຖືກຕ້ອງ."

#: libs/librepcb/core/fileio/outputdirectorywriter.cpp:124
msgctxt "librepcb::OutputDirectoryWriter"
msgid "Attempted to write file '{0}' outside the output directory, which is not allowed!"
msgstr "ມີການພະຍາຍາມຂຽນໄຟລ໌ '{0}' ນອກໂຟນເດີສົ່ງອອກ, ເຊິ່ງບໍ່ໄດ້ຮັບອະນຸຍາດ!"

#: libs/librepcb/core/fileio/outputdirectorywriter.cpp:133
msgctxt "librepcb::OutputDirectoryWriter"
msgid "The file path '{0}' is absolute, but only relative paths are allowed!"
msgstr "ເສັ້ນທາງໄຟລ໌ '{0}' ແມ່ນແບບສົມບູນ (absolute), ແຕ່ອະນຸຍາດໃຫ້ໃຊ້ສະເພາະເສັ້ນທາງແບບທຽບຖານ (relative) ເທົ່ານັ້ນ!"

#: libs/librepcb/core/fileio/outputdirectorywriter.cpp:155
msgctxt "librepcb::OutputDirectoryWriter"
msgid "Attempted to write the output file '{0}' multiple times!"
msgstr "ມີການພະຍາຍາມຂຽນໄຟລ໌ສົ່ງອອກ '{0}' ຫຼາຍຄັ້ງ!"

#: libs/librepcb/core/fileio/outputdirectorywriter.cpp:158
msgctxt "librepcb::OutputDirectoryWriter"
msgid "Make sure to specify unique output file paths, e.g. by using placeholders like '{0}' or '{1}'."
msgstr "ກະລຸນາກວດສອບໃຫ້ແນ່ໃຈວ່າໄດ້ກຳນົດເສັ້ນທາງໄຟລ໌ສົ່ງອອກທີ່ບໍ່ຊ້ຳກັນ, ເຊັ່ນ: ການໃຊ້ຕົວແທນ (placeholders) ຄື '{0}' ຫຼື '{1}'."

#: libs/librepcb/core/project/outputjobrunner.cpp:261
msgctxt "librepcb::OutputJobRunner"
msgid "Unknown output job type '{0}'."
msgstr "ປະເພດ output job '{0}' ບໍ່ຮູ້ຈັກ."

#: libs/librepcb/core/project/outputjobrunner.cpp:262
msgctxt "librepcb::OutputJobRunner"
msgid "You may need a more recent LibrePCB version to run this job."
msgstr "ທ່ານອາດຈະຕ້ອງໃຊ້ LibrePCB ເວີຊັນທີ່ໃໝ່ກວ່າເພື່ອລັນງານນີ້."

#: libs/librepcb/core/project/outputjobrunner.cpp:268
msgctxt "librepcb::OutputJobRunner"
msgid "No output files were generated, check the job configuration."
msgstr "ບໍ່ມີໄຟລ໌ສົ່ງອອກຖືກສ້າງຂຶ້ນ, ກະລຸນາກວດສອບການຕັ້ງຄ່າຂອງງານ."

#: libs/librepcb/core/project/outputjobrunner.cpp:412
msgctxt "librepcb::OutputJobRunner"
msgid "No technologies selected, thus the output files won't contain any entries."
msgstr "ບໍ່ໄດ້ເລືອກເຕັກໂນໂລຊີໃດໆ, ດັ່ງນັ້ນໄຟລ໌ທີ່ສົ່ງອອກຈະບໍ່ມີຂໍ້ມູນໃດໆ."

#: libs/librepcb/core/project/outputjobrunner.cpp:736
msgctxt "librepcb::OutputJobRunner"
msgid "The input file must be located within the project directory, specified by a relative file path."
msgstr "ໄຟລ໌ນຳເຂົ້າຕ້ອງຢູ່ໃນໂຟນເດີຂອງໂຄງການ ແລະ ກຳນົດດ້ວຍເສັ້ນທາງໄຟລ໌ແບບທຽບຖານ (relative)."

#: libs/librepcb/core/project/outputjobrunner.cpp:771
msgctxt "librepcb::OutputJobRunner"
msgid "The archive job depends on files from another job which was not run yet. Note that archive jobs can only depend on jobs further ahead in the list so you might need to reorder them."
msgstr "ງານເກັບມ້ຽນ (archive job) ຂຶ້ນກັບໄຟລ໌ຈາກງານອື່ນທີ່ຍັງບໍ່ທັນໄດ້ລັນ. ໝາຍເຫດ: ງານເກັບມ້ຽນສາມາດຂຶ້ນກັບງານທີ່ຢູ່ກ່ອນໜ້າໃນລາຍການເທົ່ານັ້ນ, ທ່ານອາດຈະຕ້ອງຈັດລຽງລຳດັບໃໝ່."

#: libs/librepcb/core/project/outputjobrunner.cpp:783
msgctxt "librepcb::OutputJobRunner"
msgid "No input jobs selected, thus the resulting archive will be empty."
