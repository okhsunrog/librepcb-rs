msgstr "ຊື່ບໍ່ຖືກຕ້ອງ: '{0}'"

#: libs/librepcb/core/project/erc/electricalrulecheckmessages.cpp:343
msgctxt "ErcMsgConnectedPinWithoutWire"
msgid "Connected pin without wire: '{0}:{1}'"
msgstr "ຂາເຊື່ອມຕໍ່ແລ້ວແຕ່ບໍ່ມີເສັ້ນສັນຍານ: '{0}:{1}'"

#: libs/librepcb/core/project/erc/electricalrulecheckmessages.cpp:345
msgctxt "ErcMsgConnectedPinWithoutWire"
msgid "The pin is electrically connected to a net, but has no wire attached so this connection is not visible in the schematic. Add a wire to make the connection visible."
msgstr "ຂາຖືກເຊື່ອມຕໍ່ທາງໄຟຟ້າເຂົ້າກັບເນັດ (net) ແລ້ວ, ແຕ່ບໍ່ມີເສັ້ນສັນຍານຕິດຢູ່ ເຮັດໃຫ້ການເຊື່ອມຕໍ່ນີ້ບໍ່ສະແດງໃຫ້ເຫັນໃນຜັງວົງຈອນ. ກະລຸນາເພີ່ມເສັ້ນສັນຍານເພື່ອໃຫ້ເຫັນການເຊື່ອມຕໍ່."

#: libs/librepcb/core/project/erc/electricalrulecheckmessages.cpp:261
msgctxt "ErcMsgForcedNetSignalNameConflict"
msgid "Net name conflict: '{0}' != '{1}' ('{2}:{3}')"
msgstr "ຊື່ເນັດຂັດແຍ້ງກັນ: '{0}' != '{1}' ('{2}:{3}')"

#: libs/librepcb/core/project/erc/electricalrulecheckmessages.cpp:265
msgctxt "ErcMsgForcedNetSignalNameConflict"
msgid "The component signal requires the attached net to be named '{0}', but it is named '{1}'. Either rename the net manually or remove this connection."
msgstr "ສັນຍານຂອງອຸປະກອນຕ້ອງການໃຫ້ເນັດທີ່ຕິດຢູ່ນັ້ນມີຊື່ວ່າ '{0}', ແຕ່ມັນພັດມີຊື່ວ່າ '{1}'. ກະລຸນາປ່ຽນຊື່ເນັດດ້ວຍຕົນເອງ ຫຼື ເອົາການເຊື່ອມຕໍ່ນີ້ອອກ."

#: libs/librepcb/core/project/erc/electricalrulecheckmessages.cpp:157
msgctxt "ErcMsgOpenNet"
msgid "Less than two pins in net: '{0}'"
msgstr "ມີໜ້ອຍກວ່າສອງຂາໃນເນັດ: '{0}'"

#: libs/librepcb/core/project/erc/electricalrulecheckmessages.cpp:158
msgctxt "ErcMsgOpenNet"
msgid "The net is connected to less than two pins, so it does not represent an electrical connection. Check if you missed to connect more pins."
msgstr "ເນັດນີ້ເຊື່ອມຕໍ່ກັບຂາໜ້ອຍກວ່າສອງຂາ, ເຮັດໃຫ້ມັນບໍ່ຖືວ່າເປັນການເຊື່ອມຕໍ່ທາງໄຟຟ້າ. ກະລຸນາກວດສອບເບິ່ງວ່າທ່ານລືມເຊື່ອມຕໍ່ຂາອື່ນໆຫຼືບໍ່."

#: libs/librepcb/core/project/erc/electricalrulecheckmessages.cpp:174
msgctxt "ErcMsgOpenNetInBus"
msgid "Bus contains unused net: '{0}:{1}'"
msgstr "ບັສ (Bus) ມີເນັດທີ່ບໍ່ໄດ້ໃຊ້: '{0}:{1}'"

#: libs/librepcb/core/project/erc/electricalrulecheckmessages.cpp:176
msgctxt "ErcMsgOpenNetInBus"
msgid "The net is connected to the bus, but is not leaving the bus ^anywhere. Check if you missed to make a connection."
msgstr "ເນັດຖືກເຊື່ອມຕໍ່ກັບບັສແລ້ວ, ແຕ່ມັນບໍ່ໄດ້ຕໍ່ອອກໄປໃສເລີຍ. ກະລຸນາກວດສອບເບິ່ງວ່າທ່ານລືມເຮັດການເຊື່ອມຕໍ່ຫຼືບໍ່."

#: libs/librepcb/core/project/erc/electricalrulecheckmessages.cpp:219
msgctxt "ErcMsgOpenWireInSegment"
msgid "Open wire in net: '{0}'"
msgstr "ມີເສັ້ນສັນຍານປາຍເປີດໃນເນັດ: '{0}'"

#: libs/librepcb/core/project/erc/electricalrulecheckmessages.cpp:220
msgctxt "ErcMsgOpenWireInSegment"
msgid "The wire has an open (unconnected) end with no net label attached, thus is looks like a mistake. Check if a connection to another wire or pin is missing (denoted by a cross mark)."
msgstr "ເສັ້ນສັນຍານມີປາຍເປີດ (ບໍ່ໄດ້ເຊື່ອມຕໍ່) ແລະ ບໍ່ມີປ້າຍຊື່ເນັດຕິດຢູ່, ເຊິ່ງເບິ່ງຄືວ່າມີຂໍ້ຜິດພາດ. ກະລຸນາກວດສອບເບິ່ງວ່າການເຊື່ອມຕໍ່ກັບເສັ້ນອື່ນ ຫຼື ຂາອື່ນຂາດຫາຍໄປຫຼືບໍ່ (ສັງເກດຈາກເຄື່ອງໝາຍກາກບາດ)."

#: libs/librepcb/core/project/erc/electricalrulecheckmessages.cpp:368
msgctxt "ErcMsgUnconnectedJunction"
msgid "Unconnected junction in net: '{0}'"
msgstr "ຈຸດຕໍ່ບໍ່ໄດ້ເຊື່ອມຕໍ່ໃນເນັດ: '{0}'"

#: libs/librepcb/core/project/erc/electricalrulecheckmessages.cpp:390
msgctxt "ErcMsgUnconnectedJunction"
msgid "Unconnected junction in bus: '{0}'"
msgstr "ຈຸດຕໍ່ບໍ່ໄດ້ເຊື່ອມຕໍ່ໃນບັສ: '{0}'"

#: libs/librepcb/core/project/erc/electricalrulecheckmessages.cpp:237
msgctxt "ErcMsgUnconnectedRequiredSignal"
msgid "Unconnected component signal: '{0}:{1}'"
msgstr "ສັນຍານອຸປະກອນບໍ່ໄດ້ເຊື່ອມຕໍ່: '{0}:{1}'"

#: libs/librepcb/core/project/erc/electricalrulecheckmessages.cpp:240
msgctxt "ErcMsgUnconnectedRequiredSignal"
msgid "The component signal is marked as required, but is not connected to any net. Add a wire to the corresponding symbol pin to connect it to a net."
msgstr "ສັນຍານຂອງອຸປະກອນຖືກກຳນົດວ່າຈຳເປັນຕ້ອງມີ, ແຕ່ບໍ່ໄດ້ເຊື່ອມຕໍ່ກັບເນັດໃດໆ. ກະລຸນາເພີ່ມເສັ້ນສັນຍານໃສ່ຂາສັນຍາລັກທີ່ກ່ຽວຂ້ອງເພື່ອເຊື່ອມຕໍ່ມັນເຂົ້າກັບເນັດ."

#: libs/librepcb/core/project/erc/electricalrulecheckmessages.cpp:196
msgctxt "ErcMsgUnnamedNetInBus"
msgid "Bus contains unnamed net: '{0}:{1}'"
msgstr "ບັສມີເນັດທີ່ບໍ່ມີຊື່: '{0}:{1}'"

#: libs/librepcb/core/project/erc/electricalrulecheckmessages.cpp:198
msgctxt "ErcMsgUnnamedNetInBus"
msgid "A wire without a net label is connected to the bus, which makes it impossible for this net to leave the bus somewhere else. Add a net label to the wire to explicitly specify the net."
msgstr "ເສັ້ນສັນຍານທີ່ບໍ່ມີປ້າຍຊື່ເນັດຖືກເຊື່ອມຕໍ່ກັບບັສ, ເຮັດໃຫ້ເນັດນີ້ບໍ່ສາມາດຕໍ່ອອກຈາກບັສໄປບ່ອນອື່ນໄດ້. ກະລຸນາເພີ່ມປ້າຍຊື່ເນັດໃສ່ເສັ້ນສັນຍານເພື່ອລະບຸເນັດໃຫ້ຊັດເຈນ."

#: libs/librepcb/core/project/erc/electricalrulecheckmessages.cpp:319
msgctxt "ErcMsgUnplacedOptionalSymbol"
msgid "Unplaced gate: '{0}:{1}'"
msgstr "ເກດທີ່ບໍ່ໄດ້ວາງ: '{0}:{1}'"

#: libs/librepcb/core/project/erc/electricalrulecheckmessages.cpp:321
msgctxt "ErcMsgUnplacedOptionalSymbol"
msgid "The optional gate '{0}' of '{1}' is not added to the schematic."
msgstr "ເກດເສີມ '{0}' ຂອງ '{1}' ບໍ່ໄດ້ຖືກເພີ່ມເຂົ້າໃນຜັງວົງຈອນ."

#: libs/librepcb/core/project/erc/electricalrulecheckmessages.cpp:293
msgctxt "ErcMsgUnplacedRequiredSymbol"
msgid "Unplaced required gate: '{0}:{1}'"
msgstr "ເກດທີ່ຈຳເປັນແຕ່ບໍ່ໄດ້ວາງ: '{0}:{1}'"

#: libs/librepcb/core/project/erc/electricalrulecheckmessages.cpp:295
msgctxt "ErcMsgUnplacedRequiredSymbol"
msgid "The gate '{0}' of '{1}' is marked as required, but it is not added to the schematic."
msgstr "ເກດ '{0}' ຂອງ '{1}' ຖືກກຳນົດວ່າຈຳເປັນ, ແຕ່ບໍ່ໄດ້ຖືກເພີ່ມເຂົ້າໃນຜັງວົງຈອນ."

#: libs/librepcb/core/project/erc/electricalrulecheckmessages.cpp:142
msgctxt "ErcMsgUnusedBus"
msgid "Unused bus: '{0}'"
msgstr "ບັສທີ່ບໍ່ໄດ້ໃຊ້: '{0}'"

#: libs/librepcb/core/project/erc/electricalrulecheckmessages.cpp:130
