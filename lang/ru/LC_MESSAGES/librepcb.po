#: libs/librepcb/editor/workspace/initializeworkspacewizard/initializeworkspacewizard_chooseworkspace.ui:17
msgctxt "librepcb::editor::InitializeWorkspaceWizard_ChooseWorkspace"
msgid "Please select a directory to open or create a LibrePCB workspace."
