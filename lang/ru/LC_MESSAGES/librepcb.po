#: libs/librepcb/editor/workspace/initializeworkspacewizard/initializeworkspacewizard_chooseworkspace.ui:29
msgctxt "librepcb::editor::InitializeWorkspaceWizard_ChooseWorkspace"
msgid ""
"<p>LibrePCB stores settings, libraries and (optionally) projects in a directory called <i>workspace</i>.</p>\n"
"<p>Workspaces are platform independent, so they can be used across different operating systems.</p>"
msgstr ""
"<p>LibrePCB хранит настройки, библиотеки и (опционально) проекты в директории, называемой <i>рабочее пространство</i>.</p>\n"
"<p>Рабочие пространства не зависят от платформы, поэтому их можно использовать в разных операционных системах.</p>"

#: libs/librepcb/editor/workspace/initializeworkspacewizard/initializeworkspacewizard_chooseworkspace.ui:53
