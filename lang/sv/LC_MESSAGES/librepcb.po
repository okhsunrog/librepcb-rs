#: libs/librepcb/editor/dialogs/backgroundimagesetupdialog.cpp:470
msgctxt "librepcb::editor::BackgroundImageSetupDialog"
msgid "This tool allows you to set a background image (typically a PCB scan) in the board editor to easily verify or reproduce an existing printed circuit board. Note that the image is exclusively visible in the board editor, not in any exported files."
msgstr "Med det här verktyget kan du ställa in en bakgrundsbild (vanligtvis en PCB-skanning) i PCB-redigeraren för att enkelt verifiera eller reproducera ett befintligt kretskort. Observera att bilden endast är synlig i PCB-redigeraren, inte i några exporterade filer."

#: libs/librepcb/editor/dialogs/backgroundimagesetupdialog.cpp:478
msgctxt "librepcb::editor::BackgroundImageSetupDialog"
msgid "This tool allows you to set a background image (typically a datasheet drawing) in the footprint editor to easily verify the size &amp; position of footprint pads etc. Note that the image won't appear on the board, it's only visible in the footprint editor."
msgstr "Det här verktyget låter dig ställa in en bakgrundsbild (vanligtvis en databladsritning) i footprint-editorn för att enkelt verifiera storleken och positionen för footprint-kuddar etc. Observera att bilden inte kommer att visas på PCB:n, den är bara synlig i footprint-editorn."

#: libs/librepcb/editor/dialogs/backgroundimagesetupdialog.cpp:487
msgctxt "librepcb::editor::BackgroundImageSetupDialog"
msgid "Load an image with one of the buttons on the left side."
msgstr "Ladda en bild med en av knapparna på vänster sida."

#: libs/librepcb/editor/dialogs/backgroundimagesetupdialog.cpp:489
msgctxt "librepcb::editor::BackgroundImageSetupDialog"
msgid "Draw a line around the area of interest to crop the image."
msgstr "Rita en linje runt området av intresse för att beskära bilden."

#: libs/librepcb/editor/dialogs/backgroundimagesetupdialog.cpp:490
msgctxt "librepcb::editor::BackgroundImageSetupDialog"
msgid "Rotate/mirror the image."
msgstr "Rotera/spegla bilden."

#: libs/librepcb/editor/dialogs/backgroundimagesetupdialog.cpp:492
msgctxt "librepcb::editor::BackgroundImageSetupDialog"
msgid "Specify two reference points to calculate X/Y scale & offset."
msgstr "Ange två referenspunkter för att beräkna X/Y-skala & offset."

#: libs/librepcb/editor/dialogs/backgroundimagesetupdialog.cpp:498
msgctxt "librepcb::editor::BackgroundImageSetupDialog"
msgid "Important: Make sure to zoom in as much as possible when taking the screenshot, to get a reasonably high resolution!"
msgstr "Viktigt: Se till att zooma in så mycket som möjligt när du tar skärmdumpen, för att få en lagom hög upplösning!"

#: libs/librepcb/editor/dialogs/backgroundimagesetupdialog.cpp:548
msgctxt "librepcb::editor::BackgroundImageSetupDialog"
msgid "Step {0}:"
msgstr "Steg {0}:"

#: libs/librepcb/editor/dialogs/backgroundimagesetupdialog.cpp:550
msgctxt "librepcb::editor::BackgroundImageSetupDialog"
msgid "Note that the two points must be located diagonally to get a large distance in both X- and Y-direction."
msgstr "Observera att de två punkterna måste placeras diagonalt för att få ett stort avstånd i både X- och Y-riktning."

#: libs/librepcb/editor/dialogs/backgroundimagesetupdialog.cpp:556
msgctxt "librepcb::editor::BackgroundImageSetupDialog"
msgid "Crop the image by drawing a line with the cursor around the area of interest (single click to skip)."
msgstr "Beskär bilden genom att dra en linje med markören runt det intressanta området (ett klick för att hoppa över)."

#: libs/librepcb/editor/dialogs/backgroundimagesetupdialog.cpp:560
msgctxt "librepcb::editor::BackgroundImageSetupDialog"
msgid "Rotate/mirror the image to get the desired orientation."
msgstr "Rotera/spegla bilden för att få önskad orientering."

#: libs/librepcb/editor/dialogs/backgroundimagesetupdialog.cpp:564
msgctxt "librepcb::editor::BackgroundImageSetupDialog"
msgid "Click into the image to select the first reference point with known X/Y coordinates."
msgstr "Klicka in i bilden för att välja den första referenspunkten med kända X/Y-koordinater."

#: libs/librepcb/editor/dialogs/backgroundimagesetupdialog.cpp:570
msgctxt "librepcb::editor::BackgroundImageSetupDialog"
msgid "Click into the image to select the second reference point with known X/Y coordinates."
msgstr "Klicka in i bilden för att välja den andra referenspunkten med kända X/Y-koordinater."

#: libs/librepcb/editor/dialogs/backgroundimagesetupdialog.cpp:576
msgctxt "librepcb::editor::BackgroundImageSetupDialog"
msgid "Too few reference points (2 required)."
msgstr "För få referenspunkter (2 krävs)."

#: libs/librepcb/editor/dialogs/backgroundimagesetupdialog.cpp:579
msgctxt "librepcb::editor::BackgroundImageSetupDialog"
msgid "Specify the target coordinates for the chosen reference points."
msgstr "Ange målkoordinaterna för de valda referenspunkterna."

#: libs/librepcb/editor/dialogs/backgroundimagesetupdialog.cpp:590
msgctxt "librepcb::editor::BackgroundImageSetupDialog"
msgid "There's not enough distance in either X- or Y direction. Choose reference points with a large distance in both directions."
msgstr "Det finns inte tillräckligt avstånd i varken X- eller Y-riktning. Välj referenspunkter med stort avstånd åt båda hållen."

#: libs/librepcb/editor/dialogs/backgroundimagesetupdialog.cpp:594
msgctxt "librepcb::editor::BackgroundImageSetupDialog"
msgid "There is a high deviation between X- and Y scale factor. Please check the reference points."
msgstr "Det finns en stor avvikelse mellan X- och Y-skalfaktor. Kontrollera referenspunkterna."

