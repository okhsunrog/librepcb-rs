#: libs/librepcb/core/project/board/drc/boarddesignrulecheckmessages.cpp:118
msgctxt "DrcMsgMissingDevice"
msgid ""
"There's a component in the schematics without a corresponding device in the board, so the circuit of the PCB is not complete.\n"
"\n"
