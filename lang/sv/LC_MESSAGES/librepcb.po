#: apps/librepcb-cli/commandlineinterface.cpp:91
msgctxt "CommandLineInterface"
msgid "Open a project to execute project-related tasks."
msgstr "Öppna ett projekt för att utföra projektrelaterade uppgifter."

#: apps/librepcb-cli/commandlineinterface.cpp:94
msgctxt "CommandLineInterface"
msgid "Open a library to execute library-related tasks."
msgstr "Öppna ett bibliotek för att utföra biblioteksrelaterade uppgifter."

#: apps/librepcb-cli/commandlineinterface.cpp:97
msgctxt "CommandLineInterface"
msgid "Open a symbol to execute symbol-related tasks."
msgstr "Öppna en symbol för att utföra symbolrelaterade uppgifter."

#: apps/librepcb-cli/commandlineinterface.cpp:100
msgctxt "CommandLineInterface"
msgid "Open a package to execute package-related tasks."
msgstr "Öppna ett paket för att utföra paketrelaterade uppgifter."

#: apps/librepcb-cli/commandlineinterface.cpp:103
msgctxt "CommandLineInterface"
msgid "Open a STEP model to execute STEP-related tasks outside of a library."
msgstr "Öppna en STEP-modell för att utföra STEP-relaterade uppgifter utanför ett bibliotek."

#: apps/librepcb-cli/commandlineinterface.cpp:110
msgctxt "CommandLineInterface"
msgid "LibrePCB Command Line Interface"
msgstr "LibrePCB kommandoradsgränssnitt"

#: apps/librepcb-cli/commandlineinterface.cpp:113
msgctxt "CommandLineInterface"
msgid "Print this message."
msgstr "Skriv ut detta meddelande."

#: apps/librepcb-cli/commandlineinterface.cpp:116
msgctxt "CommandLineInterface"
msgid "Displays version information."
msgstr "Visar versionsinformation."

#: apps/librepcb-cli/commandlineinterface.cpp:118
msgctxt "CommandLineInterface"
msgid "Verbose output."
msgstr "Utförlig utgång."

#: apps/librepcb-cli/commandlineinterface.cpp:121
msgctxt "CommandLineInterface"
msgid "The command to execute (see list below)."
msgstr "Kommandot som ska köras (se listan nedan)."

#: apps/librepcb-cli/commandlineinterface.cpp:127
msgctxt "CommandLineInterface"
msgid "Run the electrical rule check, print all non-approved warnings/errors and report failure (exit code = 1) if there are non-approved messages."
msgstr "Kör den elektriska regelkontrollen, skriv ut alla icke godkända varningar/fel och rapportera fel (utgångskod = 1) om det finns icke godkända meddelanden."

#: apps/librepcb-cli/commandlineinterface.cpp:132
msgctxt "CommandLineInterface"
msgid "Run the design rule check, print all non-approved warnings/errors and report failure (exit code = 1) if there are non-approved messages."
msgstr "Kör designregelkontrollen, skriv ut alla icke godkända varningar/fel och rapportera fel (utgångskod = 1) om det finns icke godkända meddelanden."

#: apps/librepcb-cli/commandlineinterface.cpp:137
msgctxt "CommandLineInterface"
msgid "Override DRC settings by providing a *.lp file containing custom settings. If not set, the settings from the boards will be used instead."
msgstr "Åsidosätt DRC-inställningar genom att tillhandahålla en *.lp-fil som innehåller anpassade inställningar. Om den inte är inställd kommer inställningarna från kretskorten att användas istället."

